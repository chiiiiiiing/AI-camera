{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-camera.local/schema/template_metadata.schema.json",
  "title": "AI Camera template metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "photo_id",
    "photo_type",
    "scene_category",
    "source_path",
    "source_sha256",
    "license",
    "landing_url",
    "creator",
    "width",
    "height",
    "pose",
    "annotation",
    "embedding"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "template_id": {
      "type": "string",
      "minLength": 1
    },
    "photo_id": {
      "type": "string",
      "minLength": 1
    },
    "photo_type": {
      "enum": [
        "portrait",
        "landscape",
        "still_life"
      ]
    },
    "scene_category": {
      "type": "string",
      "minLength": 1
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "license": {
      "enum": [
        "cc0",
        "pdm",
        "local_authorized"
      ]
    },
    "landing_url": {
      "type": "string",
      "format": "uri"
    },
    "creator": {
      "type": [
        "string",
        "null"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "detected",
        "keypoints_coco17",
        "keypoints_normalized",
        "joint_angles_degrees"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "detected": {
          "type": "boolean"
        },
        "keypoints_coco17": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/keypoint_list"
            }
          ]
        },
        "keypoints_normalized": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/keypoint_list"
            }
          ]
        },
        "joint_angles_degrees": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 180
              }
            }
          ]
        }
      }
    },
    "annotation": {
      "oneOf": [
        {
          "$ref": "#/$defs/rated_annotation"
        },
        {
          "$ref": "#/$defs/unrated_annotation"
        }
      ]
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "dimension",
        "path"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "ready"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "prototype",
            "teacher",
            "student"
          ]
        }
      }
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test"
      ]
    },
    "source_group_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_photo_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "recovery": {
      "type": "object"
    },
    "reference_geometry": {
      "type": "object"
    },
    "reference_review": {
      "type": "object",
      "required": [
        "photo_id",
        "source_sha256",
        "status",
        "provenance"
      ],
      "properties": {
        "photo_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "candidate_clean"
        },
        "provenance": {
          "type": "object",
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "const": "ai_visual_review"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "keypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idx",
        "x",
        "y",
        "confidence"
      ],
      "properties": {
        "idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "keypoint_list": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "$ref": "#/$defs/keypoint"
      }
    },
    "rated_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_summary",
        "composition",
        "lighting",
        "camera",
        "subject",
        "aesthetic_score",
        "template_value",
        "shooting_guidance"
      ],
      "properties": {
        "visual_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "composition": {
          "type": "object"
        },
        "lighting": {
          "type": "object"
        },
        "camera": {
          "type": "object"
        },
        "subject": {
          "type": "object"
        },
        "aesthetic_score": {
          "type": "number",
          "minimum": 3,
          "maximum": 5
        },
        "template_value": {
          "enum": [
            "medium",
            "high"
          ]
        },
        "shooting_guidance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "unrated_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aesthetic_score",
        "template_value",
        "shooting_guidance",
        "provenance"
      ],
      "properties": {
        "visual_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "composition": {
          "type": "object"
        },
        "lighting": {
          "type": "object"
        },
        "camera": {
          "type": "object"
        },
        "subject": {
          "type": "object"
        },
        "aesthetic_score": {
          "type": "null"
        },
        "template_value": {
          "const": "unrated"
        },
        "shooting_guidance": {
          "type": "array",
          "maxItems": 0
        },
        "provenance": {
          "type": "object",
          "required": [
            "aesthetic_ground_truth"
          ],
          "properties": {
            "aesthetic_ground_truth": {
              "const": false
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "template_value": {
                "const": "unrated"
              }
            },
            "required": [
              "template_value"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "then": {
        "required": [
          "reference_review"
        ]
      }
    }
  ]
}
